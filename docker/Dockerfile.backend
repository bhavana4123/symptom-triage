FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ curl build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .

RUN pip install --no-cache-dir pip setuptools wheel --upgrade

RUN pip install fastapi uvicorn scikit-learn pandas numpy \
    mlflow joblib python-dotenv requests pyarrow \
    --no-cache-dir

COPY backend/ ./backend/
COPY ml/ ./ml/
COPY data/ ./data/

# Train the model inside the container so the pickle is produced by the same
# scikit-learn version that will load it at runtime, avoiding version mismatches.
RUN python ml/data_pipeline.py
RUN python ml/train.py

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
